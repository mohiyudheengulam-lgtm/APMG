"""Path A must give a short, clear message when Ollama is not running or the model is missing. No Ollama needed."""
 
import numpy as np
import ollama
import pytest
 
from agent_on_duty.extraction.extract import DocType, ExtractedDocument, ExtractedPackage, PageText
from agent_on_duty.retrieval import path_a
from agent_on_duty.retrieval.path_a import Chunk, MultiIndex, OllamaUnavailableError, PathAIndex
 
 
def fake_embed(error):
    def embed(*args, **kwargs):
        raise error
    return embed
 
 
def text_package() -> ExtractedPackage:
    doc = ExtractedDocument(filename="INV-1.pdf", doc_type=DocType.INVOICE,
                            pages=[PageText(page=1, text="Item 10: 5 pcs at EUR 12.00")])
    return ExtractedPackage(package_id="pkg-1", documents=[doc])
 
 
def one_chunk_index() -> PathAIndex:
    ix = PathAIndex([Chunk(chunk_id=0, document="INV-1.pdf", page=1, text="Item 10")],
                    path_a.faiss.IndexFlatIP(path_a.EMBED_DIM))
    ix.index.add(np.ones((1, path_a.EMBED_DIM), dtype="float32"))
    return ix
 
 
# The exact error the ollama library raises when the Ollama app is not running.
NOT_RUNNING = ConnectionError("Failed to connect to Ollama. Please check that Ollama is downloaded, running and accessible.")
 
 
def test_build_says_ollama_not_running(tmp_path, monkeypatch):
    monkeypatch.setattr(path_a.ollama, "embed", fake_embed(NOT_RUNNING))
    with pytest.raises(OllamaUnavailableError, match="Ollama isn't running") as err:
        PathAIndex.build_docs(text_package(), tmp_path, name="pkg-1")
    # Short message: the long library traceback is not attached.
    assert err.value.__cause__ is None and err.value.__suppress_context__
 
 
def test_search_says_ollama_not_running(monkeypatch):
    monkeypatch.setattr(path_a.ollama, "embed", fake_embed(NOT_RUNNING))
    with pytest.raises(OllamaUnavailableError, match="Ollama isn't running"):
        one_chunk_index().search("unit price of item 10")
    with pytest.raises(OllamaUnavailableError, match="Ollama isn't running"):
        MultiIndex([one_chunk_index()]).search("unit price of item 10")
 
 
def test_says_model_missing(monkeypatch):
    missing = ollama.ResponseError("model 'nomic-embed-text' not found", status_code=404)
    monkeypatch.setattr(path_a.ollama, "embed", fake_embed(missing))
    with pytest.raises(OllamaUnavailableError, match="ollama pull nomic-embed-text"):
        one_chunk_index().search("unit price of item 10")
 
 
def test_other_ollama_errors_are_not_hidden(monkeypatch):
    other = ollama.ResponseError("server error", status_code=500)
    monkeypatch.setattr(path_a.ollama, "embed", fake_embed(other))
    with pytest.raises(ollama.ResponseError, match="server error"):
        one_chunk_index().search("unit price of item 10")
 
 
def test_still_a_runtime_error():
    """Code that already catches RuntimeError (or Exception, like the web app) keeps working."""
    assert issubclass(OllamaUnavailableError, RuntimeError)
 
